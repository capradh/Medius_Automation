# Copy this file to .env and fill in YOUR OWN values. Never commit .env.
# If a value contains # or spaces, wrap it in double quotes: DB_LARA_PASSWORD="pa#ss word"
#
# ===================== DATABASES =====================
# Pattern: DB_<NAME>_USER / _PASSWORD / _DSN / _ENV   (<NAME> is what you pass to --db)
# _ENV is optional: dev | uat | prod  (prod asks for confirmation before committing writes)
# To add another database, add another block. No code changes needed.

DB_CORSAIR_USER=
DB_CORSAIR_PASSWORD=
DB_CORSAIR_DSN=corsair-host.example.com:1521/CORSAIR_SERVICE
DB_CORSAIR_ENV=prod

DB_LARA_USER=
DB_LARA_PASSWORD=
DB_LARA_DSN=lara-host.example.com:1521/LARA_SERVICE
DB_LARA_ENV=prod

DEFAULT_DB=CORSAIR

# ===================== EMAIL (SMTP) =====================
# Office 365:      SMTP_HOST=smtp.office365.com  SMTP_PORT=587  SMTP_SECURITY=starttls
# Gmail:           SMTP_HOST=smtp.gmail.com      SMTP_PORT=587  SMTP_SECURITY=starttls (needs an App Password)
# Internal relay:  SMTP_HOST=mailrelay.company.com  SMTP_PORT=25  SMTP_SECURITY=none  (leave USER/PASSWORD empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=
# Default recipients for --notify (comma or semicolon separated)
EMAIL_TO=

# ===================== REST API =====================
API_BASE_URL=https://jsonplaceholder.typicode.com
API_KEY=
# Sent as:  <API_KEY_HEADER>: <API_KEY_PREFIX> <API_KEY>
API_KEY_HEADER=Authorization
API_KEY_PREFIX=Bearer
API_TIMEOUT=30
API_MAX_RETRIES=3
# true | false | path to a corporate CA bundle (.pem)
API_VERIFY_SSL=true

# ===================== OTHER =====================
LOG_LEVEL=INFO
# Only needed for Oracle "thick mode" (native network encryption, some auth types):
# ORACLE_CLIENT_LIB_DIR=C:\oracle\instantclient_21_9
